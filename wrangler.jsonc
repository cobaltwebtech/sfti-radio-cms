{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "sfti-radio-cms",
  "compatibility_date": "2025-11-17",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
	  "placement": {
    "mode": "smart"
  },
  "workers_dev": false,
  "observability": {
		"enabled": true
	},
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Top-level bindings for type generation (these get overridden by env-specific bindings)
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "b02b9c00-b3eb-4441-b54d-d6167d39b864",
      "database_name": "sfti-radio-cms-prod"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_CMS_MEDIA",
      "bucket_name": "sfti-radio-cms-media-prod"
    },
    {
      "binding": "R2_UPLOADS",
      "bucket_name": "sfti-radio-cms-uploads-prod"
    }
  ],
  // Payload requires specific environment bindings
  "env": {
    // Production environment bindings used to access prod resources remotely
    "prod": {
      "d1_databases": [
        {
          "binding": "D1",
          "database_id": "b02b9c00-b3eb-4441-b54d-d6167d39b864",
          "database_name": "sfti-radio-cms-prod",
          "remote": true
        }
      ],
      "r2_buckets": [
        {
          "binding": "R2_CMS_MEDIA",
          "bucket_name": "sfti-radio-cms-media-prod"
        },
        {
          "binding": "R2_UPLOADS",
          "bucket_name": "sfti-radio-cms-uploads-prod"
        }
      ]
    },
    // Development environment bindings used to access resources seperate from production
    "dev": {
      "d1_databases": [
        {
          "binding": "D1",
          "database_id": "265fbab9-d442-4f4b-89fa-a87d5fbac92f",
          "database_name": "tstfi-radio-cms-dev"
        }
      ],
      "r2_buckets": [
        {
          "binding": "R2_CMS_MEDIA",
          "bucket_name": "tsfti-radio-cms-media-dev"
        },
        {
          "binding": "R2_UPLOADS",
          "bucket_name": "tsfti-radio-cms-uploads-dev"
        }
      ]
    }
  }
}
